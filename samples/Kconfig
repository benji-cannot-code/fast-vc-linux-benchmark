# samples/Kconfig

menuconfig SAMPLES
	bool "Sample kernel code"
	help
	  You can build and test sample kernel code here.

if SAMPLES

config SAMPLE_MARKERS
	tristate "Build markers examples -- loadable modules only"
	depends on MARKERS && m
	help
	  This build markers example modules.

endif # SAMPLES
